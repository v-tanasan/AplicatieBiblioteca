<Window
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="NivelUIWPF.MainWindow"
        Title="Manager Biblioteca Virtuala" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Window.Resources>
        <!-- Stiluri comune -->
        <Style TargetType="{x:Type Button}" x:Key="MenuButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34495E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#34495E"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2D3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F2D3A"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ActionButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2ECC71"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2ECC71"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E8449"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E8449"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigare Sidebar -->
        <Border Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10">
                <TextBlock Text="BIBLIOTECA VIRTUALA" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,20,0,30" FontWeight="Bold"/>

                <Button x:Name="btnMeniuImprumuturi" Content="Imprumuturi" Style="{StaticResource MenuButton}" Click="btnMeniuImprumuturi_Click"/>
                <Button x:Name="btnMeniuCarti" Content="Lista carti" Style="{StaticResource MenuButton}" Click="btnMeniuCarti_Click"/>
                <Button Content="Cititori" Style="{StaticResource MenuButton}" Click="btnMeniuOperatii_Click"/>
                <Button x:Name="btnMeniuOperatii" Content="Imprumut / Restituire" Style="{StaticResource MenuButton}" Click="btnMeniuOperatii_Click"/>

                <Separator Margin="0,20" Background="#34495E"/>
                <!--<Button Content="Settings" Style="{StaticResource MenuButton}"/>-->
            </StackPanel>
        </Border>

        <!-- Zona principala continut (fereastra principala) -->
        <TabControl x:Name="tabPrincipal" Grid.Column="1" BorderThickness="0" Background="Transparent">

            <!-- Tab Management Carti -->
            <TabItem Header="Carti">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Management carti" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                        <!-- Sectiune introducere carti -->
                        <Grid x:Name="grdIntroDate">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14*"/>
                                <ColumnDefinition Width="47*"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="Titlul:" Grid.Row="0" Grid.Column="0" Margin="0,10,0,2"/>
                            <TextBox x:Name="txtTitlu" Grid.Row="0" ToolTip="Introduceti titlul cartii ..." Margin="64,0,10,5" VerticalContentAlignment="Center" Grid.ColumnSpan="3"/>
                            <Label Content="Autorul:" Grid.Row="1" Grid.Column="0" Margin="0,10,0,2"/>
                            <TextBox x:Name="txtAutor" Grid.Row="1" ToolTip="Introduceti autorul cartii ..." Margin="64,0,10,0" VerticalContentAlignment="Center" Grid.ColumnSpan="3"/>
                        </Grid>

                        <!-- Butoane rapide -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Button x:Name="btnAdaugaCarte" Content="Adauga carte" Width="120" Background="#27AE60" Foreground="White" Margin="0,0,10,0" Style="{StaticResource ActionButton}" Click="btnAdaugaCarte_Click"/>
                            <Button x:Name="btnAfiseaza" Content="Afiseaza cartile" Width="120" Margin="0,0,10,0" Style="{StaticResource ActionButton}" Click="btnAfiseaza_Click"/>
                            <Button x:Name="btnAfisareUltima" Content="Ultima carte" Width="120" Style="{StaticResource ActionButton}" Click="btnUltima_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Afisare date -->
                    <DataGrid x:Name="dataGridCarti" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                            <DataGridTextColumn Header="Titlu" Binding="{Binding Titlu}" Width="*"/>
                            <DataGridTextColumn Header="Autor" Binding="{Binding Autor}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Background="#C0392B" Foreground="White" Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource ActionButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="txtEroare" Text="" Grid.Row="2" FontSize="12" FontWeight="Bold" Margin="5,10,5,5"/>
                </Grid>
            </TabItem>

            <!-- Tab Cititori si Imprumuturi/Restituiri-->
            <TabItem Header="Operatiuni">
                <Grid x:Name="panelCititori" Margin="20,10,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="2" Margin="20,10,20,20">
                        <!-- Inregistrare cititor -->
                        <GroupBox Header="Inregistrare cititor" Margin="10">
                            <StackPanel Margin="10">
                                <Label Content="Nume si prenume"/>
                                <TextBox x:Name="txtNumeCititor"/>
                                <Label Content="Cnp"/>
                                <TextBox x:Name="txtCnpCititor"/>
                                <Label Content="Email"/>
                                <TextBox x:Name="txtEmailCititor"/>
                                <Button x:Name="btnInregistrare" Content="Inregistrare" Margin="0,20,0,0" Height="35" Background="#27AE60" Foreground="White" Style="{StaticResource ActionButton}" Click="btnInregistrare_Click"/>
                                <TextBlock x:Name="txtEroareInregistrare" FontSize="12" FontWeight="Bold" Margin="0,10,0,-1" />
                            </StackPanel>
                        </GroupBox>

                        <!-- Sectiunea Imprumut / Returnare -->
                        <GroupBox Header="Operatiuni Imprumut/Restituire" Margin="10">
                            <StackPanel Margin="12,0,8,0">
                                <Label Content="Carte" Margin="0,5,0,2"/>
                                <ComboBox x:Name="cmbCarte" DisplayMemberPath="Titlu" SelectedValuePath="Id" Margin="5,2,5,5"/>
                                <Label Content="Cititor" Margin="0,5,0,2"/>
                                <ComboBox x:Name="cmbCititor" DisplayMemberPath="Nume" SelectedValuePath="Id" Margin="5,2,5,5"/>
                                <Button x:Name="btnImprumuta" Grid.Column="0" Content="Imprumuta" Margin="0,10,5,0" Height="35" Background="#8E44AD" Foreground="White" Style="{StaticResource ActionButton}" Click="btnImprumuta_Click"/>

                                <!--
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnImprumuta" Grid.Column="0" Content="Imprumuta" Margin="0,0,5,0" Height="35" Background="#8E44AD" Foreground="White" Style="{StaticResource ActionButton}" Click="btnImprumuta_Click"/>
                                    <Button x:Name="btnReturneaza" Grid.Column="1" Content="Returneaza" Margin="5,0,0,0" Height="35" Background="#F39C12" Foreground="White" Style="{StaticResource ActionButton}"/>
                                </Grid>
                                -->

                                <Label Content="Carte" Margin="0,15,0,2"/>
                                <ComboBox x:Name="cmbCarteReturnare" DisplayMemberPath="Titlu" SelectedValuePath="Id" Margin="5,2,5,2"/>
                                <Label Content="Cititor" Margin="0,5,0,2"/>
                                <ComboBox x:Name="cmbCititorReturnare" DisplayMemberPath="Nume" SelectedValuePath="Id" Margin="5,2,5,5"/>
                                <Button x:Name="btnReturneaza" Grid.Column="1" Content="Returneaza" Margin="5,10,0,0" Height="35" Background="#F39C12" Foreground="White" Style="{StaticResource ActionButton}" Click="btnReturneaza_Click"/>

                            </StackPanel>
                        </GroupBox>
                    </UniformGrid>
                    <DataGrid x:Name="dgCititori" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                            <DataGridTextColumn Header="Nume" Binding="{Binding Nume}" Width="Auto"/>
                            <DataGridTextColumn Header="Cnp" Binding="{Binding Cnp}" Width="*"/>
                            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab-ul Imprumuturi -->
            <TabItem Header="Imprumuturi">
                <Grid Margin="20">
                    <Grid Margin="0,0,0,20">
                        <!-- DEFINIM RANDURI -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DEFINIM COLOANE -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LINIA 1 -->
                        <TextBlock Text="Imprumuturi carte" FontSize="24" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"/>

                        <!-- LINIA 2 -->
                        <!--<TextBlock Text="Gaseste carte dupa titlu, autor, sau categorie." Grid.Row="1" Grid.Column="0" Margin="0,0,10,10"/>-->
                        <Separator Grid.Row="1" Margin="0,20,0,5" Grid.ColumnSpan="3"/>

                        <!-- LINIA 3 -->
                        <!--
                        <TextBox x:Name="txtCautImprumut" Height="35" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbCautImprumut" Width="100" Height="30" SelectedIndex="0" Grid.Row="2" Grid.Column="1">
                            <ComboBoxItem Content="Carte"/>
                            <ComboBoxItem Content="Autor"/>
                        </ComboBox>
                        <StackPanel x:Name="stkxx" Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btnCautaxx" Content="Cauta" Width="100" Height="35" Style="{StaticResource ActionButton}" Click="btnCauta_Click"/>
                            <Button x:Name="btnResetxx" Content="Reset" Width="100" Height="35" Style="{StaticResource ActionButton}" Click="btnReset_Click"/>
                        </StackPanel>
                        -->

                        <!-- LINIA 4 -->
                        <DataGrid x:Name="dataGridImprumuturi" Grid.Row="3" Grid.ColumnSpan="3" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Margin="0,10,15,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="65"/>
                                <DataGridTextColumn Header="Id carte" Binding="{Binding IdCarte}" Width="100"/>
                                <DataGridTextColumn Header="Id cititor" Binding="{Binding IdCititor}" Width="100"/>
                                <DataGridTextColumn Header="Data imprumut" Binding="{Binding DataImprumutFormatata}" Width="Auto"/>
                                <DataGridTextColumn Header="Data imprumut" Binding="{Binding DataReturnareFormatata}" Width="Auto"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- LINIA 5 -->
                        <TextBlock x:Name="txtEroareImprumuturi" Grid.Row="4" Grid.ColumnSpan="3" FontSize="12" FontWeight="Bold" Margin="5,10,5,0" Height="25"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab Cautare -->
            <TabItem Header="Cautare" HorizontalAlignment="Center" Width="60" Height="23" VerticalAlignment="Top">
                <Grid Margin="20">
                    <Grid Margin="0,0,0,20">
                        <!-- DEFINIM RANDURI -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DEFINIM COLOANE -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LINIA 1 -->
                        <TextBlock Text="Cauta carte" FontSize="24" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"/>

                        <!-- LINIA 2 -->
                        <TextBlock Text="Gaseste carte dupa titlu, autor, sau categorie." Grid.Row="1" Grid.Column="0" Margin="0,0,10,10"/>
                        <Separator Grid.Row="1" Margin="0,20,0,5" Grid.ColumnSpan="3"/>

                        <!-- LINIA 3 -->
                        <TextBox x:Name="txtSearch" Height="35" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbSearchType" Width="100" Height="30" SelectedIndex="0" Grid.Row="2" Grid.Column="1">
                            <ComboBoxItem Content="Carte"/>
                            <ComboBoxItem Content="Autor"/>
                        </ComboBox>
                        <StackPanel x:Name="stkButoane" Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btnCauta" Content="Cauta" Width="100" Height="35" Style="{StaticResource ActionButton}" Click="btnCauta_Click"/>
                            <Button x:Name="btnReset" Content="Reset" Width="100" Height="35" Style="{StaticResource ActionButton}" Click="btnReset_Click"/>
                        </StackPanel>

                        <!-- LINIA 4 -->
                        <DataGrid x:Name="dataGridCautare" Grid.Row="3" Grid.ColumnSpan="3" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Margin="0,10,15,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                                <DataGridTextColumn Header="Titlu" Binding="{Binding Titlu}" Width="250"/>
                                <DataGridTextColumn Header="Autor" Binding="{Binding Autor}" Width="160"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- LINIA 5 -->
                        <TextBlock x:Name="txtEroareCautare" Grid.Row="4" Grid.ColumnSpan="3" FontSize="12" FontWeight="Bold" Margin="5,10,5,0" Height="25"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
