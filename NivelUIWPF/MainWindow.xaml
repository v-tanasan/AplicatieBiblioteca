<Window x:Class="NivelUIWPF.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Librarie Virtuala" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Window.Resources>
        <!-- Stiluri comune -->
        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34495E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#34495E"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2D3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F2D3A"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2ECC71"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2ECC71"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E8449"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E8449"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        
        
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigare Sidebar -->
        <Border Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10">
                <TextBlock Text="LIBRARIE VIRTUALA" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,20,0,30" FontWeight="Bold"/>

                <Button Content="Dashboard" Style="{StaticResource MenuButton}" Command="{Binding NavDashboardCommand}"/>
                <Button Content="Lista carti" Style="{StaticResource MenuButton}" Command="{Binding NavBooksCommand}"/>
                <Button Content="Cititori" Style="{StaticResource MenuButton}" Command="{Binding NavReadersCommand}"/>
                <Button Content="Imprumut / Restituire" Style="{StaticResource MenuButton}" Command="{Binding NavLendingCommand}"/>

                <Separator Margin="0,20" Background="#34495E"/>
                <Button Content="Settings" Style="{StaticResource MenuButton}"/>
            </StackPanel>
        </Border>

        <!-- Zona principala continut (fereastra principala) -->
        <TabControl Grid.Column="1" BorderThickness="0" Background="Transparent">

            <!-- Tab Management Carti -->
            <TabItem Header="Carti">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Management carti" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                        <!-- Sectiune Search -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBox Width="250" ToolTip="Cauta carte sau autor..." Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                            <Button Content="Cauta Carte" Width="100" Margin="0,0,5,0" Style="{StaticResource ActionButton}"/>
                            <Button Content="Cauta Autor" Width="100" Style="{StaticResource ActionButton}"/>
                        </StackPanel>

                        <!-- Butoane rapide -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Adauga carte" Width="120" Background="#27AE60" Foreground="White" Margin="0,0,10,0" Style="{StaticResource ActionButton}"/>
                            <Button Content="Afiseaza cartile" Width="120" Margin="0,0,10,0" Style="{StaticResource ActionButton}"/>
                            <Button Content="Ultima carte" Width="120" Style="{StaticResource ActionButton}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Afisare date -->
                    <DataGrid x:Name="dataGridCarti" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                            <DataGridTextColumn Header="Titlu" Binding="{Binding Titlu}" Width="*"/>
                            <DataGridTextColumn Header="Autor" Binding="{Binding Autor}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Background="#C0392B" Foreground="White" Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Style="{StaticResource ActionButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab Cititori si Imprumuturi/Restituiri-->
            <TabItem Header="Operatiuni">
                <UniformGrid Columns="2" Margin="20">
                    <!-- Inregistrare cititor -->
                    <GroupBox Header="Inregistrare cititor" Margin="10">
                        <StackPanel Margin="10">
                            <Label Content="Nume si prenume"/>
                            <TextBox Name="NumeCititor"/>
                            <Label Content="Email"/>
                            <TextBox Name="EmailCititor"/>
                            <Button Content="Inregistrare" Margin="0,20,0,0" Height="35" Background="#27AE60" Foreground="White" Style="{StaticResource ActionButton}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Sectiunea Imprumut / Returnare -->
                    <GroupBox Header="Operatiuni Imprumut/Restituire" Margin="10">
                        <StackPanel Margin="10">
                            <Label Content="ID Carte"/>
                            <TextBox Name="IdCarte"/>
                            <Label Content="ID Cititor"/>
                            <TextBox Name="IdCititor"/>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Imprumuta" Margin="0,0,5,0" Height="35" Background="#8E44AD" Foreground="White" Style="{StaticResource ActionButton}"/>
                                <Button Grid.Column="1" Content="Returneaza" Margin="5,0,0,0" Height="35" Background="#F39C12" Foreground="White" Style="{StaticResource ActionButton}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </UniformGrid>
            </TabItem>

            <!-- Tab Cautare -->
            <TabItem Header="Cautare">
                <Grid Margin="20">
                    <!--
                    <StackPanel Width="400">
                        <TextBlock Text="Cauta carte" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock Text="Gaseste carte dupa titlu, autor, sau categorie." Margin="0,0,0,20"/>
                    -->    
                    <!--
                        <TextBox Name="txtSearch" Height="35" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                        
                        <TextBlock Text="Introdu un cuvant si apasa Cauta" FontSize="10" Margin="0,0,0,20"/>
                        <Button Content="Cauta" Height="35" Style="{StaticResource ActionButton}"/>
                        -->
                    <!--    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBox x:Name="txtSearch" Width="250" Height="35" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                            <Button Content="Cauta" Width="100" Height="35" Style="{StaticResource ActionButton}"/>
                        </StackPanel>
                        <TextBlock Text="Introdu un cuvant si apasa Cauta" FontSize="10" Margin="0,0,0,20"/>
                    </StackPanel>
                    -->
                    <Grid Margin="0,0,0,20">
                        <!-- DEFINIM RANDURI -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DEFINIM COLOANE -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LINIA 1 -->
                        <TextBlock Text="Cauta carte" FontSize="24" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"/>
                        <!--
                        <Button Grid.Row="0" Grid.Column="1" Content="Alt buton" Width="100" Height="35"/>
                        -->

                        <!-- LINIA 2 -->
                        <TextBlock Text="Gaseste carte dupa titlu, autor, sau categorie." Grid.Row="1" Grid.Column="0" Margin="0,0,10,30"/>
                        <Separator Grid.Row="1" Margin="0,10"/>
                        <!--
                        <Button Grid.Row="1" Grid.Column="1" Content="Cauta" Width="100" Height="35" Style="{StaticResource ActionButton}"/>
                        -->

                        <!-- LINIA 3 -->
                        <TextBox Name="txtSearch" Height="35" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbSearchType" Width="120" Height="30" SelectedIndex="0" Grid.Row="2" Grid.Column="1">
                            <ComboBoxItem Content="Carte"/>
                            <ComboBoxItem Content="Autor"/>
                        </ComboBox>
                        <Button Grid.Row="2" Grid.Column="2" Content="Cauta" Width="100" Height="35" Style="{StaticResource ActionButton}"/>
                    </Grid>
                    
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
